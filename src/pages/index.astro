---
import { Image, getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR } from '../consts';
import { getLang, useCounts, useTranslations } from '../i18n/ui';
import MainLayout from '../layouts/MainLayout.astro';
import { getPosts, getTopics } from '../lib/posts';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const count = useCounts(lang);
const topicsUrl = getRelativeLocaleUrl(lang, 'topics');
const aboutUrl = getRelativeLocaleUrl(lang, 'about');
const topics = await getTopics(lang);

// One featured row per topic (the first three by `order`), linking to the topic page.
// Rows alternate text-left / image-left like the theme.
// The cover is a plain <img> without width/height, as in the theme: its CSS sizes the image
// by height, which fixed width/height attributes would distort.
const featured = await Promise.all(
	topics.slice(0, 3).map(async (topic) => ({ topic, cover: (await getImage({ src: topic.entry.data.cover })).src })),
);

// "Latest from the blog": the newest posts of all topics.
const latest = (await getPosts(lang)).slice(0, 3);

const dividerUrl = topics.find((topic) => topic.path === 'tam-thuc')?.url ?? topicsUrl;
---

<MainLayout activeNav="home">

		<!-- Hero Section-->
		<section style="background: url(/img/hero.jpg); background-size: cover; background-position: center center;" class="hero">
			<div class="container">
				<div class="row">
					<div class="col-lg-7">
						<h1>{t('home.hero.title')}</h1>
						<a href={topicsUrl} class="hero-link">{t('home.hero.cta')}</a>
					</div>
				</div>
				<a href=".intro" class="continue link-scroll"><i class="fa fa-long-arrow-down"></i> {t('home.hero.scroll')}</a>
			</div>
		</section>

		<!-- Intro Section-->
		<section class="intro">
			<div class="container">
				<div class="row">
					<div class="col-lg-8">
						<h2 class="h3">{t('home.intro.title')}</h2>
						<p class="text-big" set:html={t('home.intro.text')} />
					</div>
				</div>
			</div>
		</section>

		<!-- Featured Posts Section-->
		<section class="featured-posts no-padding-top">
			<div class="container">
				{
					featured.map(({ topic, cover }, index) => {
						const { title, description } = topic.entry.data;
						const image = (
							<div class="image col-lg-5" style="min-height: 346.797px">
								<a href={topic.url} class="d-block h-100">
									<img src={cover} alt="" />
								</a>
							</div>
						);
						return (
							<div class="row d-flex align-items-stretch">
								{index % 2 === 1 && image}
								<div class="text col-lg-7">
									<div class="text-inner d-flex align-items-center">
										<div class="content">
											<header class="post-header">
												<div class="category">
													<a href={topic.url}>{t('level.topic')}</a>
												</div>
												<a href={topic.url}>
													<h2 class="h4">{title}</h2>
												</a>
											</header>
											<p>{description}</p>
											<footer class="post-footer d-flex align-items-center">
												<a href={aboutUrl} class="author d-flex align-items-center flex-wrap">
													<div class="avatar">
														<img src={AUTHOR.avatar} alt="" class="img-fluid" />
													</div>
													<div class="title"><span>{AUTHOR.name}</span></div>
												</a>
												<div class="date">
													<i class="fa fa-folder-open-o"></i> {count.series(topic.children.length)}
												</div>
												<div class="comments">
													<i class="fa fa-file-text-o"></i> {count.posts(topic.postCount)}
												</div>
											</footer>
										</div>
									</div>
								</div>
								{index % 2 === 0 && image}
							</div>
						);
					})
				}
			</div>
		</section>

		<!-- Divider Section-->
		<section style="background: url(/img/divider-bg.jpg); background-size: cover; background-position: center bottom;" class="divider">
			<div class="container">
				<div class="row">
					<div class="col-md-7">
						<h2>{t('home.divider.text')}</h2>
						<a href={dividerUrl} class="hero-link">{t('home.divider.cta')}</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Latest Posts -->
		<section class="latest-posts">
			<div class="container">
				<header>
					<h2>{t('home.latest.title')}</h2>
					<p class="text-big">{t('home.latest.lead')}</p>
				</header>
				<div class="row">
					{
						latest.map((post, index) => {
							const { title, description, pubDate, heroImage } = post.entry.data;
							return (
								<div class="post col-md-4">
									<div class="post-thumbnail">
										<a href={post.url}>
											{heroImage ? (
												<Image src={heroImage} width={720} height={480} alt="" class="img-fluid" />
											) : (
												<img src={`/img/blog-${index + 1}.jpg`} alt="" class="img-fluid" />
											)}
										</a>
									</div>
									<div class="post-details">
										<div class="post-meta d-flex justify-content-between">
											<div class="date"><FormattedDate date={pubDate} format="card" /></div>
											<div class="category"><a href={post.series.url}>{post.series.title}</a></div>
										</div>
										<a href={post.url}>
											<h3 class="h4">{title}</h3>
										</a>
										<p class="text-muted">{description}</p>
									</div>
								</div>
							);
						})
					}
				</div>
			</div>
		</section>

		<!-- Newsletter Section: sample form from the theme, not connected to any service yet -->
		<section class="newsletter no-padding-top">
			<div class="container">
				<div class="row">
					<div class="col-md-6">
						<h2>{t('home.newsletter.title')}</h2>
						<p class="text-big">{t('home.newsletter.lead')}</p>
					</div>
					<div class="col-md-8">
						<div class="form-holder">
							<form action="/">
								<div class="form-group">
									<input type="email" name="email" id="email" placeholder={t('home.newsletter.placeholder')} />
									<button type="submit" class="submit">{t('home.newsletter.submit')}</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Gallery Section-->
		<section class="gallery no-padding">
			<div class="row">
				<div class="mix col-lg-3 col-md-3 col-sm-6">
					<div class="item">
						<a href="/img/gallery-1.jpg" data-fancybox="gallery" class="image">
							<img src="/img/gallery-1.jpg" alt="..." class="img-fluid" />
							<div class="overlay d-flex align-items-center justify-content-center">
								<i class="icon-search"></i>
							</div>
						</a>
					</div>
				</div>
				<div class="mix col-lg-3 col-md-3 col-sm-6">
					<div class="item">
						<a href="/img/gallery-2.jpg" data-fancybox="gallery" class="image">
							<img src="/img/gallery-2.jpg" alt="..." class="img-fluid" />
							<div class="overlay d-flex align-items-center justify-content-center">
								<i class="icon-search"></i>
							</div>
						</a>
					</div>
				</div>
				<div class="mix col-lg-3 col-md-3 col-sm-6">
					<div class="item">
						<a href="/img/gallery-3.jpg" data-fancybox="gallery" class="image">
							<img src="/img/gallery-3.jpg" alt="..." class="img-fluid" />
							<div class="overlay d-flex align-items-center justify-content-center">
								<i class="icon-search"></i>
							</div>
						</a>
					</div>
				</div>
				<div class="mix col-lg-3 col-md-3 col-sm-6">
					<div class="item">
						<a href="/img/gallery-4.jpg" data-fancybox="gallery" class="image">
							<img src="/img/gallery-4.jpg" alt="..." class="img-fluid" />
							<div class="overlay d-flex align-items-center justify-content-center">
								<i class="icon-search"></i>
							</div>
						</a>
					</div>
				</div>
			</div>
		</section>
</MainLayout>
