---
import { getRelativeLocaleUrl } from 'astro:i18n';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getLang, useTranslations } from '../../i18n/ui';
import MainLayout from '../../layouts/MainLayout.astro';
import { getPostsByLang } from '../../lib/posts';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const posts = await getPostsByLang(lang);
---

<MainLayout title={t('nav.blog')} activeNav="blog">
	<div class="container">
		<div class="row">
			<main class="posts-listing col-lg-8">
				<div class="container">
					<div class="row">
						{posts.map(({ post, slug }) => <PostCard post={post} href={getRelativeLocaleUrl(lang, `blog/${slug}`)} />)}
					</div>
				</div>
			</main>

			<Sidebar />
		</div>
	</div>
</MainLayout>
