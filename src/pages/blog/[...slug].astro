---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { type PostPageProps, getPostStaticPaths } from '../../lib/posts';

export async function getStaticPaths() {
	return getPostStaticPaths('vi');
}

type Props = PostPageProps;

const { post, availableLangs } = Astro.props;
const { Content } = await render(post);
---

<PostLayout {...post.data} availableLangs={availableLangs}>
	<Content />
</PostLayout>
