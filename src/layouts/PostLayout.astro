---
import '../styles/prose.css';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import FormattedDate from '../components/FormattedDate.astro';
import PostComments from '../components/PostComments.astro';
import Sidebar from '../components/Sidebar.astro';
import { AUTHOR } from '../consts';
import { type Lang, getLang, useTranslations } from '../i18n/ui';
import { type Post, type Series, getRelativeTime } from '../lib/posts';
import MainLayout from './MainLayout.astro';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	author?: string;
	authorAvatar?: string;
	commentCount?: number;
	// Set on posts: the series it belongs to, its position, and its neighbours
	series?: Series;
	part?: number;
	prev?: Post;
	next?: Post;
	activeNav?: 'series' | 'about';
	// Language of the file being shown and the languages that have their own file
	contentLang?: Lang;
	translations?: Lang[];
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author = AUTHOR.name,
	authorAvatar = AUTHOR.avatar,
	commentCount,
	series,
	part,
	prev,
	next,
	activeNav = 'series',
	contentLang,
	translations,
} = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const hasComments = commentCount !== undefined;
// The page's language has no file for this post, so another language's file is shown
const fallbackLang = contentLang !== lang ? contentLang : undefined;
---

<MainLayout
	title={title}
	description={description}
	image={heroImage}
	activeNav={activeNav}
	contentLang={contentLang}
	translations={translations}
>
	<div class="container">
		<div class="row">
			<main class="post blog-post col-lg-8">
				<div class="container">
					<article class="post-single">
						{
							heroImage && (
								<div class="post-thumbnail">
									<Image src={heroImage} width={1020} alt="" class="img-fluid" />
								</div>
							)
						}
						<div class="post-details">
							{
								series && (
									<div class="post-meta d-flex justify-content-between">
										<div class="category">
											{series.ancestors.map((parent) => (
												<a href={parent.url}>{parent.title}</a>
											))}
											<a href={series.url}>{series.entry.data.title}</a>
											<a href={series.url}>
												{t('post.part')} {part}/{series.posts.length}
											</a>
										</div>
									</div>
								)
							}
							<h1 lang={fallbackLang}>
								{title}
								{pubDate && <a href="#"><i class="fa fa-bookmark-o" /></a>}
							</h1>
							{
								pubDate && (
									<div class="post-footer d-flex align-items-center flex-column flex-sm-row">
										<a href={getRelativeLocaleUrl(lang, 'about')} class="author d-flex align-items-center flex-wrap">
											<div class="avatar">
												<img src={authorAvatar} alt="" class="img-fluid" />
											</div>
											<div class="title">
												<span>{author}</span>
											</div>
										</a>
										<div class="d-flex align-items-center flex-wrap">
											<div class="date">
												<i class="icon-clock" />
												<time datetime={pubDate.toISOString()}>{getRelativeTime(pubDate, lang)}</time>
											</div>
											{updatedDate && (
												<div class="date">
													{t('post.updated')} <FormattedDate date={updatedDate} />
												</div>
											)}
											{/* Sample view count from the theme */}
											<div class:list={['views', { 'meta-last': !hasComments }]}>
												<i class="icon-eye" /> 500
											</div>
											{hasComments && (
												<div class="comments meta-last">
													<i class="icon-comment" />
													{commentCount}
												</div>
											)}
										</div>
									</div>
								)
							}
							{fallbackLang && <p class="small text-muted font-italic mt-3 mb-0">{t('post.fallback')}</p>}
							<div class="post-body" lang={fallbackLang}>
								<slot />
							</div>
							{
								/* Sample tags and comments from the theme, hard-coded for now */
								pubDate && (
										<>
										<div class="post-tags">
											<a href="#" class="tag">#Business</a><a href="#" class="tag">#Tricks</a><a href="#" class="tag">#Financial</a><a href="#" class="tag">#Economy</a>
										</div>
										<div class="posts-nav d-flex justify-content-between align-items-stretch flex-column flex-md-row">
											{prev && (
												<a href={prev.url} class="prev-post text-left d-flex align-items-center">
													<div class="icon prev">
														<i class="fa fa-angle-left" />
													</div>
													<div class="text">
														<strong class="text-primary">{t('post.prev')} </strong>
														<h6>{prev.entry.data.title}</h6>
													</div>
												</a>
											)}
											{next && (
												<a href={next.url} class="next-post text-right d-flex align-items-center justify-content-end ml-auto">
													<div class="text">
														<strong class="text-primary">{t('post.next')} </strong>
														<h6>{next.entry.data.title}</h6>
													</div>
													<div class="icon next">
														<i class="fa fa-angle-right" />
													</div>
												</a>
											)}
									</div>
										<PostComments />
									</>
								)
							}
						</div>
					</article>
				</div>
			</main>

			<Sidebar series={series} current={part} />
		</div>
	</div>
</MainLayout>
