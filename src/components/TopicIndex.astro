---
import { Image } from 'astro:assets';
import { getLang, useCounts } from '../i18n/ui';
import type { Series } from '../lib/posts';

// One topic on the topics page: a table-of-contents box listing its series, after the sidebar's "Categories" widget.
interface Props {
	topic: Series;
}

const { topic } = Astro.props;
const { title, description, cover } = topic.entry.data;
const count = useCounts(getLang(Astro.currentLocale));
---

<div class="widget categories topic-index">
	<header class="d-flex align-items-center">
		<a href={topic.url} class="topic-index-thumb">
			<Image src={cover} width={180} height={180} alt="" />
		</a>
		<div>
			<div class="topic-index-count">{count.series(topic.children.length)} · {count.posts(topic.postCount)}</div>
			<h3 class="h5">
				<a href={topic.url}>{title}</a>
			</h3>
			<p class="small text-muted mb-0">{description}</p>
		</div>
	</header>
	{
		topic.children.map((series) => (
			<div class="item d-flex justify-content-between">
				<a href={series.url}>{series.entry.data.title}</a>
				<span>{count.posts(series.postCount)}</span>
			</div>
		))
	}
</div>

<style>
	.topic-index header {
		margin-bottom: 25px;
	}

	.topic-index-thumb {
		flex: 0 0 90px;
		margin-right: 20px;
	}

	.topic-index-thumb img {
		display: block;
		width: 90px;
		height: 90px;
		object-fit: cover;
	}

	.topic-index-count {
		margin-bottom: 4px;
		color: #999;
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.topic-index h3 {
		margin-bottom: 6px;
	}

	.topic-index h3 a {
		color: #222;
		text-decoration: none;
	}
</style>
