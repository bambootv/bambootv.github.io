---
import { getLang, useTranslations } from '../i18n/ui';
import type { Series } from '../lib/posts';

interface Props {
	// On a post page: its series and the part being read
	series?: Series;
	current?: number;
}

const { series, current } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<aside class="col-lg-4">
	{
		series && (
			<div class="widget categories">
				<header>
					<h3 class="h6">{t('series.inThis')}</h3>
				</header>
				{series.posts.map((post) => (
					<div class:list={['item d-flex justify-content-between', { current: post.part === current }]}>
						<a href={post.url} aria-current={post.part === current ? 'page' : undefined}>
							{post.entry.data.title}
						</a>
						<span>{post.part}</span>
					</div>
				))}
			</div>
		)
	}
	<!-- The widgets below are samples from the theme, placeholders until real data is wired in. -->
	<!-- Widget [Search Bar Widget]-->
	<div class="widget search">
		<header>
			<h3 class="h6">Search the blog</h3>
		</header>
		<form action="#" class="search-form">
			<div class="form-group">
				<input type="search" placeholder="What are you looking for?" />
				<button type="submit" class="submit">
					<i class="icon-search"></i>
				</button>
			</div>
		</form>
	</div>
	<!-- Widget [Latest Posts Widget] -->
	<div class="widget latest-posts">
		<header>
			<h3 class="h6">Latest Posts</h3>
		</header>
		<div class="blog-posts">
			<a href="#">
				<div class="item d-flex align-items-center">
					<div class="image">
						<img src="/img/small-thumbnail-1.jpg" alt="..." class="img-fluid" />
					</div>
					<div class="title">
						<strong>Alberto Savoia Can Teach You About</strong>
						<div class="d-flex align-items-center">
							<div class="views"><i class="icon-eye"></i> 500</div>
							<div class="comments"><i class="icon-comment"></i>12</div>
						</div>
					</div>
				</div>
			</a>
			<a href="#">
				<div class="item d-flex align-items-center">
					<div class="image">
						<img src="/img/small-thumbnail-2.jpg" alt="..." class="img-fluid" />
					</div>
					<div class="title">
						<strong>Alberto Savoia Can Teach You About</strong>
						<div class="d-flex align-items-center">
							<div class="views"><i class="icon-eye"></i> 500</div>
							<div class="comments"><i class="icon-comment"></i>12</div>
						</div>
					</div>
				</div>
			</a>
			<a href="#">
				<div class="item d-flex align-items-center">
					<div class="image">
						<img src="/img/small-thumbnail-3.jpg" alt="..." class="img-fluid" />
					</div>
					<div class="title">
						<strong>Alberto Savoia Can Teach You About</strong>
						<div class="d-flex align-items-center">
							<div class="views"><i class="icon-eye"></i> 500</div>
							<div class="comments"><i class="icon-comment"></i>12</div>
						</div>
					</div>
				</div>
			</a>
		</div>
	</div>
	<!-- Widget [Categories Widget]-->
	<div class="widget categories">
		<header>
			<h3 class="h6">Categories</h3>
		</header>
		<div class="item d-flex justify-content-between">
			<a href="#">Growth</a><span>12</span>
		</div>
		<div class="item d-flex justify-content-between">
			<a href="#">Local</a><span>25</span>
		</div>
		<div class="item d-flex justify-content-between">
			<a href="#">Sales</a><span>8</span>
		</div>
		<div class="item d-flex justify-content-between">
			<a href="#">Tips</a><span>17</span>
		</div>
		<div class="item d-flex justify-content-between">
			<a href="#">Local</a><span>25</span>
		</div>
	</div>
	<!-- Widget [Tags Cloud Widget]-->
	<div class="widget tags">
		<header>
			<h3 class="h6">Tags</h3>
		</header>
		<ul class="list-inline">
			<li class="list-inline-item">
				<a href="#" class="tag">#Business</a>
			</li>
			<li class="list-inline-item">
				<a href="#" class="tag">#Technology</a>
			</li>
			<li class="list-inline-item">
				<a href="#" class="tag">#Fashion</a>
			</li>
			<li class="list-inline-item">
				<a href="#" class="tag">#Sports</a>
			</li>
			<li class="list-inline-item">
				<a href="#" class="tag">#Economy</a>
			</li>
		</ul>
	</div>
</aside>

<style>
	.widget.categories .item.current,
	.widget.categories .item.current span {
		color: #000;
	}
</style>
